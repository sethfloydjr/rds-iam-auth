# Automated PSQL IAM user provisioning — mirrors the approach used in mysql.tf.
#
# The `rds_iam` role is the PostgreSQL equivalent of MySQL's AWSAuthenticationPlugin.
# Any database user granted this role can authenticate using a short-lived IAM token
# generated by `aws rds generate-db-auth-token` instead of a static password.
#
# Run `terraform apply -target=module.psql_rds` first if the provider reports a
# dependency cycle on the first apply (the endpoint is unknown until the DB exists).

# Developer user — read/write access
resource "postgresql_role" "iam_dev_user" {
  name  = var.rds_dev_user
  login = true

  depends_on = [module.psql_rds]
}

resource "postgresql_grant" "iam_dev_user_connect" {
  database    = "postgres"
  role        = postgresql_role.iam_dev_user.name
  object_type = "database"
  # CONNECT is all that is needed for IAM auth. CREATE (schema creation) is removed —
  # the developer cannot create other users (requires CREATEROLE role attribute) or alter
  # system settings (requires superuser). Schema/table grants should be added separately
  # per application requirements once the target databases and schemas exist.
  privileges = ["CONNECT"]

  depends_on = [postgresql_role.iam_dev_user]
}

# Grant the rds_iam role so this user can log in with an IAM auth token.
resource "postgresql_grant_role" "iam_dev_user_rds_iam" {
  role       = postgresql_role.iam_dev_user.name
  grant_role = "rds_iam"

  depends_on = [postgresql_role.iam_dev_user]
}


# Read-only user — SELECT access only
resource "postgresql_role" "iam_ro_user" {
  name  = var.rds_ro_user
  login = true

  depends_on = [module.psql_rds]
}

resource "postgresql_grant" "iam_ro_user_connect" {
  database    = "postgres"
  role        = postgresql_role.iam_ro_user.name
  object_type = "database"
  privileges  = ["CONNECT"]

  depends_on = [postgresql_role.iam_ro_user]
}

# Grant the rds_iam role so this user can log in with an IAM auth token.
resource "postgresql_grant_role" "iam_ro_user_rds_iam" {
  role       = postgresql_role.iam_ro_user.name
  grant_role = "rds_iam"

  depends_on = [postgresql_role.iam_ro_user]
}
